# Streamlit native OIDC login (st.login) with Google.
# Local:  cp .streamlit/secrets.toml.example .streamlit/secrets.toml
# Cloud:  stored in Secret Manager as "streamlit-auth" and mounted at /app/.streamlit/secrets.toml
#
# Create the OAuth client in Google Cloud Console -> APIs & Services -> Credentials ->
# "OAuth client ID" (Web application). Authorised redirect URI must match redirect_uri below.

[auth]
redirect_uri = "http://localhost:8501/oauth2callback"   # Cloud Run: https://<service-url>/oauth2callback
cookie_secret = "generate-with: python -c 'import secrets; print(secrets.token_urlsafe(32))'"
client_id = "xxxxxxxx.apps.googleusercontent.com"
client_secret = "GOCSPX-xxxxxxxx"
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"
