# Copy to .env for local development: cp .env.example .env

# Google Cloud
GCP_PROJECT=your-gcp-project-id
GCP_LOCATION=us-central1
GCS_BUCKET=your-hr-policies-bucket
GCS_PREFIX=hr-policies/

# Qdrant Cloud
QDRANT_URL=https://xxxxxxxx.us-east4-0.gcp.cloud.qdrant.io:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=hr_policies

# Jina AI (https://jina.ai/api-dashboard)
JINA_API_KEY=

# LLMs via LiteLLM: Vertex AI uses Application Default Credentials (gcloud auth application-default login)
PRIMARY_MODEL=vertex_ai/gemini-2.5-flash
FALLBACK_MODEL=groq/llama-3.3-70b-versatile
GROQ_API_KEY=

# Model Armor
MODEL_ARMOR_ENABLED=true
MODEL_ARMOR_LOCATION=us-central1
MODEL_ARMOR_TEMPLATE=hr-rag-template

# Semantic cache
CACHE_ENABLED=true
CACHE_SIMILARITY_THRESHOLD=0.95

# LangSmith tracing
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=hr-rag-assistant

# Access control (at least one must be set, or nobody can log in)
ALLOWED_DOMAINS=yourcompany.com
ALLOWED_EMAILS=

# Local only: skip Google login. Never set this on Cloud Run.
AUTH_DISABLED=false
